# ─────────────────────────────────────────────
#  StoreLogistic — plantilla de variables de entorno
#  Copiar a .env y completar con valores reales
# ─────────────────────────────────────────────

# ── Base de datos ──────────────────────────────
POSTGRES_DB=storeLogistic
POSTGRES_USER=
POSTGRES_PASSWORD=

# Opción A: URL completa (docker-compose local)
DB_URL=jdbc:postgresql://postgres:5432/storeLogistic
# Opción B: variables individuales (Render — las inyecta automáticamente desde la DB)
DB_HOST=
DB_PORT=5432
DB_NAME=storeLogistic
DB_USER=
DB_PASS=

# ── RabbitMQ ───────────────────────────────────
RABBITMQ_DEFAULT_USER=
RABBITMQ_DEFAULT_PASS=
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASS=
RABBITMQ_VHOST=/

# ── Aplicación ─────────────────────────────────
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# ── Servicio de transportistas (externo) ───────
TRANSPORTER_SERVICE_URL=

# ── Módulo financiero (externo) ────────────────
FINANCE_MODULE_BASE_URL=
FINANCE_TIMEOUT_MS=3000
FINANCE_RETRY_MAX_ATTEMPTS=3
FINANCE_RETRY_INITIAL_INTERVAL_MS=500
FINANCE_RETRY_MULTIPLIER=2.0
